.server-sidebar.h-100.d-flex.flex-column
    .server-sidebar-header
        span.server-sidebar-title 服务器
        .server-sidebar-actions
            button(type='button', (click)='createNewSSHConnection()', [ngbTooltip]='"New connection"|translate')
                i.fas.fa-plus
            button(
                type='button',
                (click)='openSessionForSelectedProfile()',
                [disabled]='!selectedProfile',
                [ngbTooltip]='"New session"|translate'
            )
                i.fas.fa-terminal
            button(
                type='button',
                (click)='editSelectedProfile()',
                [disabled]='!canManageSelectedProfile',
                [ngbTooltip]='"Edit profile"|translate'
            )
                i.fas.fa-pen
            button.danger(
                type='button',
                (click)='deleteSelectedProfile()',
                [disabled]='!canManageSelectedProfile',
                [ngbTooltip]='"Delete profile"|translate'
            )
                i.far.fa-trash-can
            button(type='button', (click)='refreshProfiles()', [ngbTooltip]='"Refresh"|translate')
                i.fas.fa-rotate
    .server-search-row
        .server-search
            i.fas.fa-magnifying-glass
            input(
                type='text',
                [(ngModel)]='filter',
                placeholder='搜索...',
                (ngModelChange)='onFilterChange()'
            )
            button.server-search-clear(
                *ngIf='filter',
                type='button',
                (click)='clearFilter()',
                [ngbTooltip]='"Clear search"|translate'
            )
                i.fas.fa-xmark

    .profile-tree.h-100
        .d-flex.flex-column.profile-tree-container
            a.tree-item.server-item(
                *ngFor='let profile of servers',
                (click)='selectProfile(profile, $event)',
                (dblclick)='openNewSession(profile, $event)',
                [class.selected]='isSelectedProfile(profile)',
                (contextmenu)='profileContextMenu(profile, $event)',
                href='#'
            )
                i.server-icon.fas.fa-server
                span.profile-name {{ profile.name }}
                span.session-status(*ngIf='hasOpenSession(profile)')
                .actions
                    .action((click)='openNewSession(profile, $event)', [ngbTooltip]='"New session"|translate')
                        .fa.fa-fw.fas.fa-plus
            .server-empty(*ngIf='servers.length == 0')
                span 未找到 SSH 连接
.grabber((mousedown)='startResize($event)')
