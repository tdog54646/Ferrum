.server-sidebar.h-100.d-flex.flex-column
    .server-sidebar-header
        span.server-sidebar-title 连接
        .server-sidebar-actions
            button(type='button', [ngbTooltip]='"Import"|translate')
                i.fas.fa-download
            button(type='button', [ngbTooltip]='"Export"|translate')
                i.fas.fa-upload
            button(type='button', [ngbTooltip]='"Collapse all"|translate')
                i.fas.fa-angles-up
            button(type='button', [ngbTooltip]='"New group"|translate')
                i.far.fa-folder-open
            button(type='button', (click)='refreshProfiles()', [ngbTooltip]='"Refresh"|translate')
                i.fas.fa-rotate
            button(type='button', [ngbTooltip]='"Collapse sidebar"|translate')
                i.fas.fa-angles-left
    .server-search-row
        .server-search
            i.fas.fa-magnifying-glass
            input(
                type='text',
                [(ngModel)]='filter',
                placeholder='搜索...',
                (ngModelChange)='onFilterChange()'
            )
        button.server-search-tool(type='button', [ngbTooltip]='"Locate"|translate')
            i.fas.fa-crosshairs
        button.server-search-tool(type='button', [ngbTooltip]='"Sort"|translate')
            i.fas.fa-list-ol
        button.server-search-tool(type='button', [ngbTooltip]='"Filter"|translate')
            i.fas.fa-filter

    .profile-tree.h-100
        .d-flex.flex-column.profile-tree-container
            a.tree-item.server-item(
                *ngFor='let profile of servers',
                (click)='selectProfile(profile, $event)',
                (dblclick)='openNewSession(profile, $event)',
                [class.selected]='isSelectedProfile(profile)',
                (contextmenu)='profileContextMenu(profile, $event)',
                href='#'
            )
                i.server-chevron.fas.fa-chevron-right
                i.server-icon.fas.fa-server
                span.profile-name {{ profile.name }}
                span.session-status(*ngIf='hasOpenSession(profile)')
                .actions
                    .action((click)='openNewSession(profile, $event)', [ngbTooltip]='"New session"|translate')
                        .fa.fa-fw.fas.fa-plus
            .server-empty(*ngIf='servers.length == 0')
                span 未找到 SSH 连接
.grabber((mousedown)='startResize($event)')
