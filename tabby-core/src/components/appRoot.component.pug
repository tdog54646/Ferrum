title-bar(
  *ngIf='ready && !hostWindow.isFullscreen && config.store.appearance.dock == "off" && isTitleBarNeeded()',
  (dblclick)='toggleMaximize()',
  [hideControls]='hostApp.platform !== Platform.Linux && !hostWindow.isFullscreen',
  [class.inset]='hostApp.platform == Platform.macOS && !hostWindow.isFullscreen'
)

.dbx-toolbar(
    *ngIf='ready',
    (dblclick)='toggleMaximize()'
)
    .mac-traffic-light-space(*ngIf='hostApp.platform == Platform.macOS && !hostWindow.isFullscreen')
    button.dbx-toolbar-action.primary-action(
        (click)='openConnectionSelector()',
        [ngbTooltip]='"Profiles & connections"|translate'
    )
        i.fas.fa-database
        span 新建连接
    button.dbx-toolbar-action(
        (click)='openSessionForSelectedServer()',
        [ngbTooltip]='"Open a new session for the selected server"|translate'
    )
        i.far.fa-file
        span 新建会话
    button.dbx-toolbar-action(type='button')
        i.fas.fa-arrow-right-arrow-left
        span 数据传输
    button.dbx-toolbar-action(type='button')
        i.fas.fa-cube
        span 终端管理
    button.dbx-toolbar-action(type='button')
        span 更多
        i.fas.fa-chevron-down.toolbar-chevron
    .dbx-toolbar-space
    .dbx-toolbar-icons
        button.dbx-icon-button(type='button', [ngbTooltip]='"Updates"|translate')
            i.fas.fa-cloud-arrow-down
        button.dbx-icon-button(type='button', [ngbTooltip]='"Saved sessions"|translate')
            i.far.fa-bookmark
        button.dbx-icon-button(type='button', [ngbTooltip]='"File browser"|translate')
            i.fas.fa-folder-tree
        button.dbx-icon-button(type='button', [ngbTooltip]='"History"|translate')
            i.fas.fa-clock-rotate-left
        button.dbx-icon-button(type='button', [ngbTooltip]='"Toolbox"|translate')
            i.fas.fa-toolbox
        button.dbx-icon-button(type='button', [ngbTooltip]='"Theme"|translate')
            i.far.fa-sun
        button.dbx-icon-button(type='button', [ngbTooltip]='"GitHub"')
            i.fab.fa-github
        button.dbx-icon-button(type='button', (click)='openSettings()', [ngbTooltip]='"Settings"|translate')
            i.fas.fa-gear
    window-controls(
        *ngIf='config.store.appearance.frame == "thin" && hostApp.platform == Platform.Linux'
    )

.window.d-flex
    profile-tree(
        *ngIf='ready && config.store.showProfileTree'
    )

    .content.main.h-100(
        *ngIf='ready',
        [class.tabs-on-top]='config.store.appearance.tabsLocation == "top" || config.store.appearance.tabsLocation == "left" || config.store.appearance.tabsLocation == "right"',
        [class.tabs-on-left]='hasVerticalTabs() && config.store.appearance.tabsLocation == "left"',
        [class.tabs-titlebar-enabled]='isTitleBarNeeded()',
        [class.tabs-on-right]='hasVerticalTabs() && config.store.appearance.tabsLocation == "right"',
    )
        .tab-bar(
            *ngIf='!hostWindow.isFullscreen || config.store.appearance.tabsInFullscreen',
            [class.tab-bar-no-controls-overlay]='hostApp.platform == Platform.macOS',
            (dblclick)='!isTitleBarNeeded() && toggleMaximize()'
        )
            .tabs(
                cdkDropList,
                [cdkDropListOrientation]='(config.store.appearance.tabsLocation == "top" || config.store.appearance.tabsLocation == "bottom") ? "horizontal" : "vertical"',
                (cdkDropListDropped)='onTabsReordered($event)',
                cdkAutoDropGroup='app-tabs'
            )
                tab-header(
                    *ngFor='let tab of app.tabs; let idx = index',
                    [index]='idx',
                    [tab]='tab',
                    [active]='tab == app.activeTab',
                    [@animateTab]='{value: "in", params: {size: targetTabSize}}',
                    [@.disabled]='hasVerticalTabs() || !config.store.accessibility.animations',
                    (click)='app.selectTab(tab)',
                    [class.fully-draggable]='hostApp.platform !== Platform.macOS',
                    [ngbTooltip]='tab.customTitle || tab.title'
                )

            button.session-add-button(
                (click)='openSessionForSelectedServer()',
                [ngbTooltip]='"Open a new session for the selected server"|translate'
            )
                i.fas.fa-plus

            .btn-space.background(
                [class.persistent]='config.store.appearance.frame == "thin"',
                [class.drag]='config.store.appearance.frame == "thin" \
                && ((config.store.appearance.tabsLocation !== "left" && config.store.appearance.tabsLocation !== "right") || hostApp.platform !== Platform.macOS)'
            )
        .session-toolbar(*ngIf='app.tabs.length > 0')
            .session-toolbar-left
                button.session-tool.primary(type='button', (click)='restartActiveSession()', [ngbTooltip]='"Reconnect"|translate')
                    i.fas.fa-play
                button.session-tool(type='button', [ngbTooltip]='"Split terminal"|translate')
                    i.fas.fa-code-branch
                button.session-tool(type='button', [ngbTooltip]='"Command history"|translate')
                    span Tx
                button.session-tool(type='button', [ngbTooltip]='"Clear terminal"|translate')
                    i.fas.fa-align-left
                button.session-tool(type='button', [ngbTooltip]='"Font"|translate')
                    span A
                button.session-tool(type='button', [ngbTooltip]='"Save output"|translate')
                    i.far.fa-floppy-disk
                button.session-tool(type='button', (click)='openActiveSFTP()', [ngbTooltip]='"SFTP"|translate')
                    i.far.fa-folder-open
                button.session-tool(type='button', [ngbTooltip]='"Download"|translate')
                    i.fas.fa-download
                button.session-tool(type='button', [ngbTooltip]='"Upload"|translate')
                    i.fas.fa-file-export
            .session-toolbar-space
            .active-server-context
                i.fas.fa-server
                strong {{activeServerName}}
                i.fas.fa-chevron-down.context-chevron
            .active-server-context.secondary(*ngIf='activeServerDescription')
                i.fas.fa-terminal
                span {{activeServerDescription}}
                i.fas.fa-chevron-down.context-chevron
            button.session-close(type='button', (click)='closeActiveSession()', [ngbTooltip]='"Close session"|translate')
                i.fas.fa-xmark
            span.session-default 设置为默认
        .content
            start-page.content-tab.content-tab-active(*ngIf='ready && app.tabs.length == 0')

            tab-body.content-tab(
                #tabBodies,
                *ngFor='let tab of unsortedTabs',
                [class.content-tab-active]='tab == app.activeTab',
                [active]='tab == app.activeTab',
                [tab]='tab',
            )

ng-template(ngbModalContainer)
