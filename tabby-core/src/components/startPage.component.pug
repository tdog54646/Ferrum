
.mt-auto.mb-auto
    .list-group.mb-4
        a.list-group-item.list-group-item-action.d-flex.pt-3.pb-3(
            *ngFor='let command of commands; trackBy: buttonsTrackBy',
            (click)='command.run()',
        )
            .d-flex.align-self-center([innerHTML]='sanitizeIcon(command.icon)')
            span {{command.label}}
