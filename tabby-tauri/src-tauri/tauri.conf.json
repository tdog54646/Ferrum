{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrum",
  "version": "0.1.0",
  "identifier": "com.ferrum.terminal",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ferrum",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../build/icons/32x32.png",
      "../../build/icons/128x128.png",
      "../../build/icons/256x256.png",
      "../../build/icons/512x512.png",
      "../../build/mac/icon.icns"
    ]
  }
}
